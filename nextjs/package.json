{
  "name": "ahmed-saber-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start:static": "NO_UPDATE_CHECK=1 serve out -l tcp://127.0.0.1:4173 --no-clipboard --no-port-switching --no-request-logging",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run build && npm run test:e2e",
    "test": "vitest run --exclude 'tests/e2e/**'"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serve": "^14.2.6",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
